{
  "manifest_version": 3,
  "name": "蓝V回关检查",
  "version": "1.3.2",
  "description": "Find blue-check accounts you have followed for more than 3, 5, or 7 days that do not follow you back.",
  "permissions": ["storage", "activeTab", "tabs"],
  "action": {
    "default_title": "蓝V回关检查",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
